# Copie para .env e preencha. NUNCA commite o .env.

# --- Segredos (gere com: openssl rand -hex 32) ---
SECRET_KEY=
POSTGRES_PASSWORD=
INTERNAL_API_TOKEN=
# Chave Fernet para credenciais de câmeras (gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CREDENTIALS_KEY=

# --- Usuário administrador inicial (criado no primeiro boot) ---
ADMIN_EMAIL=admin@horus.local
ADMIN_PASSWORD=

# --- Portas expostas ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Retenção / disco ---
MAX_DISK_USAGE_PCT=90

# --- Banco (padrão: postgres do compose). Para instalação doméstica/SQLite:
# DATABASE_URL=sqlite+aiosqlite:////data/horus.db
# DATABASE_URL=

# --- MinIO (perfil "archive", opcional) ---
MINIO_ROOT_USER=horus
MINIO_ROOT_PASSWORD=

# --- Túnel SSH para câmeras (perfil "tunnel", opcional) ---
# Use quando as câmeras estão em uma rede acessível apenas via um jump host.
# Requer chave SSH em config/camera-proxy/ssh_key e mapeamentos em
# config/camera-proxy/tunnels.conf (copie de tunnels.example.conf).
TUNNEL_SSH_HOST=
TUNNEL_SSH_USER=
TUNNEL_SSH_PORT=22
